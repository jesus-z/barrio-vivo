region             = "us-ashburn-1" # Reemplaza por la región de tu tenancy OCI
compartment_ocid   = "ocid1.compartment.oc1..REEMPLAZAR"
project_name       = "barrio-vivo"
admin_cidr         = "203.0.113.10/32" # Reemplaza por tu IP pública actual
ssh_public_key     = "ssh-ed25519 AAAA... tu-clave-publica"

# Ampere A1 ARM: valores predeterminados dentro del límite Always Free publicado por Oracle.
instance_shape        = "VM.Standard.A1.Flex"
instance_fault_domain = "" # Opcional: FAULT-DOMAIN-1, FAULT-DOMAIN-2 o FAULT-DOMAIN-3
instance_ocpus        = 2
instance_memory_gbs   = 12
boot_volume_size_gbs  = 50
existing_boot_volume_ocid = "" # Deja vacío para Ubuntu 24.04 nuevo; usa un OCID solo para restaurar un disco separado

